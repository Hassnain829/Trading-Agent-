# =============================================================================
#  Autonomous AI Hedge Fund - environment configuration
#  Copy this file to ".env" in the same folder and fill in your own values.
#  Never commit the real .env file: it contains credentials.
# =============================================================================

# --- DeepSeek LLM -------------------------------------------------------------
# API key from https://platform.deepseek.com (Settings -> API keys).
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# Base URL of the OpenAI-compatible DeepSeek endpoint (no trailing slash).
DEEPSEEK_API_BASE=https://api.deepseek.com
# Chat model used by both the trading brain and the risk auditor.
DEEPSEEK_MODEL=deepseek-chat
# (The same three settings can also be written LLM_API_KEY / LLM_API_BASE / LLM_MODEL.)
#
# NVIDIA free endpoints instead of DeepSeek credits (key from build.nvidia.com):
#   DEEPSEEK_API_KEY=nvapi-...
#   DEEPSEEK_API_BASE=https://integrate.api.nvidia.com/v1
#   DEEPSEEK_MODEL=nvidia/nemotron-3-super-120b-a12b
#   LLM_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning-30b-a3b
#   LLM_REASONING=off
#
# Comma-separated backup models tried in order when the main model times out,
# is overloaded (429/5xx), is not available to your key (404) or answers empty.
LLM_FALLBACK_MODELS=
# off = ask reasoning models to skip their "thinking" phase (much faster, far
# fewer timeouts on shared free endpoints); default = leave the model as is.
LLM_REASONING=default
# Seconds to wait for one answer, and the answer budget in tokens (reasoning
# models spend tokens thinking before they write the JSON decision).
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=4096

# --- MetaTrader 5 -------------------------------------------------------------
# Numeric account number. Leave blank to reuse the account already logged in
# inside the running MT5 terminal.
MT5_LOGIN=your_mt5_account_number
# Trading (master) password of the account above.
MT5_PASSWORD=your_mt5_password
# Broker server name exactly as shown in the MT5 login dialog.
MT5_SERVER=Exness-MT5Trial7
# Optional full path to terminal64.exe, e.g.
# C:\Program Files\MetaTrader 5 EXNESS\terminal64.exe
# Leave blank to let the MetaTrader5 package locate the installed terminal.
MT5_PATH=

# --- Risk & engine cadence ----------------------------------------------------
# Percent of live equity risked per trade (distance entry -> stop loss).
# Hard-capped at 5.0 by the engine.
DEFAULT_RISK_PERCENT=1.0
# Seconds to wait after a full scan of every symbol before the next scan.
SCAN_INTERVAL_SECONDS=30
# Minimum AI confidence (0-100) required to act on a BUY/SELL signal.
# Anything below is forced to HOLD.
CONFIDENCE_THRESHOLD=65
# Symbols to trade, one list for demo accounts and one for live accounts. The bot
# detects which kind of account is logged in and uses the matching list. Plain
# names work on every broker: EURUSD is matched to EURUSDm (Exness), EURUSD.r, etc.
# Both lists can also be edited from the dashboard's Settings drawer.
SYMBOLS_DEMO=EURUSD,GBPUSD,USDJPY,USDCHF,USDCAD,AUDUSD,NZDUSD,BTCUSD,XAUUSD
SYMBOLS_LIVE=EURUSD,GBPUSD,USDJPY,USDCHF,USDCAD,AUDUSD,NZDUSD,XAUUSD
# (Older .env files with a single SYMBOLS= line keep working: it is used for both lists.)

# --- Self-learning auditor ----------------------------------------------------
# Which learned rules apply after switching account or broker (also in the Settings drawer):
# PAIR   = a rule learned on EURUSD applies to EURUSD at any broker, demo or live (EURUSDm, EURUSD.r...)
# BROKER = rules apply only at the broker they were learned at (e.g. Exness demo -> Exness live)
RULE_SCOPE=PAIR
# Hours between automatic audits of the last 50 closed trades (24 = once a day).
# The dashboard's "Run Audit Now" button and `python auditor.py --force` ignore it.
AUDIT_INTERVAL_HOURS=24

# --- Strategy (optional) -------------------------------------------------------
# SCALP = rules find M5 RSI pullbacks in the D1 trend (M15 must agree) and the AI confirms or vetoes each;
#         trades only from the London open to midday New York and closes at SL, TP or the time stop.
# SWING = the AI judges every symbol on each closed H1 bar (the original mode).
STRATEGY_MODE=SCALP
SCALP_TIME_STOP_MINUTES=60
SCALP_MAX_TRADES_PER_SYMBOL=4
SCALP_REWARD_RISK=1.5
SCALP_RSI_PULLBACK=40
SCALP_SESSION_START_LONDON=7
SCALP_SESSION_END_NEW_YORK=16
# Backtest the scalping rules on MT5 history (also from the dashboard's Scalp Backtest panel):
#   .venv\Scripts\python.exe backtest.py --days 90

# --- Portfolio guardrails (optional) -------------------------------------------
# Maximum simultaneous open positions across all symbols (0 = unlimited).
MAX_OPEN_POSITIONS=5
# Halt new entries until the next trading day (17:00 New York) once equity falls this
# many percent below the trading day's starting equity (0 = disabled). The starting
# equity and a tripped limit are saved in risk_state.json, so restarts cannot reset them.
MAX_DAILY_LOSS_PERCENT=5.0
# Close the bot's own positions when the daily loss limit trips (manual trades stay).
DAILY_LOSS_CLOSE_POSITIONS=true
# Refuse a new trade when today's loss + the risk of every open stop + the new trade
# could exceed MAX_DAILY_LOSS_PERCENT.
DAILY_LOSS_RISK_BUDGET=true
# Account protection from the equity PEAK (kept per account across days and restarts; 0 = off).
# Past the throttle level new trades use half the risk; at the kill-switch level no new trades
# are opened until you reset it in Settings (also reset after a withdrawal).
MAX_TOTAL_DRAWDOWN_PERCENT=10
DRAWDOWN_THROTTLE_PERCENT=5
# Close the bot's own positions when the kill-switch trips (manual trades stay).
KILL_SWITCH_CLOSE_POSITIONS=true
# Max open risk in one direction of one currency, in % of equity (0 = off).
# 2.5 allows two 1% trades that are both long USD (e.g. SELL EURUSD + BUY USDJPY), not a third.
MAX_CURRENCY_RISK_PERCENT=2.5
# Refuse a trade when the broker's minimum lot would risk more than this multiple
# of the intended risk (1.25 = up to 25% over budget).
MIN_LOT_RISK_TOLERANCE=1.25
# Halt new entries until the next trading day once equity is this many percent
# above the trading day's starting equity (0 = disabled).
MAX_DAILY_PROFIT_PERCENT=0
# RISK = size every trade from DEFAULT_RISK_PERCENT and the ATR stop.
# FIXED = always trade FIXED_LOT lots (refused if that would risk more than 5%).
POSITION_SIZING_MODE=RISK
FIXED_LOT=0.01
# Protection guards the engine applies on top of the AI (true/false):
# cut confidence when price is overextended from EMA200 or RSI is extreme in the trade direction.
OVEREXTENSION_GUARD=true
# No new entries this many hours before the Friday forex close (17:00 New York). 0 = off.
# Crypto symbols that trade at weekends are exempt.
WEEKEND_ENTRY_CUTOFF_HOURS=3
# Close the bot's own non-crypto trades ~45 minutes before the Friday close.
WEEKEND_CLOSE=false
# No new entries from NEWS_BLOCK_BEFORE_MINUTES before to NEWS_BLOCK_AFTER_MINUTES after
# high-impact news for either currency of a symbol (free Forex Factory calendar feed).
NEWS_GUARD=true
NEWS_BLOCK_BEFORE_MINUTES=30
NEWS_BLOCK_AFTER_MINUTES=15
# Ask the AI again only when a new H1 bar has closed or price moved 0.5 ATR since its
# last answer (the indicators only change once per hour).
AI_NEW_BAR_ONLY=true
# After a losing trade, no new trade in the same direction on that symbol for this long.
LOSS_COOLDOWN_MINUTES=120
# Flipping an open position needs this much more confidence than a fresh entry.
REVERSAL_EXTRA_CONFIDENCE=10
# Refuse an order when price moved more than this many H1 ATRs while the AI was deciding.
MAX_ENTRY_DRIFT_ATR=0.5
# Raise the confidence threshold automatically when executed trades at that confidence
# lost money (needs 10+ closed trades; never lowers it).
CALIBRATE_THRESHOLD=true
# Learned rules expire after this many days unless the daily audit reconfirms them.
RULE_TTL_DAYS=30
# Everything in this section (plus risk, interval, threshold and symbols) can also
# be changed live from the dashboard's Settings drawer; those choices are saved
# in settings.json and override this file until you press "Reset to .env".
# Start the trading engine automatically when the server boots (true/false).
# Useful for unattended 24/7 restarts; default keeps the engine in standby.
AUTO_START_ENGINE=false

# --- Machine-learning setup filter (optional) ------------------------------------
# Train with: python -m ml.train. The filter only acts when the latest training APPROVED a
# model (purged walk-forward, beats "no model" at +1 pip, Deflated Sharpe >= 0.95); skipped
# setups are followed as shadow trades (blocker ML-FILTER). Also switchable in Settings.
ML_FILTER=false

# --- Backtest realism (optional) -------------------------------------------------
# Slippage in POINTS (10 points = 1 pip on 5-digit pairs) on entries and stop/time exits.
BACKTEST_SLIPPAGE_POINTS=0
# Round-trip commission per standard lot in account currency (0 on spread-only accounts).
BACKTEST_COMMISSION_PER_LOT=0
# Strategy variants tried so far: the Deflated Sharpe Ratio raises the bar with it.
BACKTEST_TRIALS=24

# --- Dashboard server (optional) -----------------------------------------------
# Keep 127.0.0.1 unless you secure the network: the dashboard can place and
# close live trades and has no login.
HOST=127.0.0.1
PORT=8000
